# Persian RAG System — example environment file
# Copy to .env and adjust. List values use JSON syntax, e.g. ["a", "b"].

# --- API / server -----------------------------------------------------------
DEBUG=false
WORKERS=1
# LOG_LEVEL: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# --- Security ---------------------------------------------------------------
# Real origins when serving browsers; credentials are only allowed when the
# list contains no "*".
CORS_ORIGINS=["*"]
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# --- LLM --------------------------------------------------------------------
# LLM_PROVIDER: "openai" or "qwen"
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=1
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=2

# Local Qwen generation (LLM_PROVIDER=qwen)
QWEN_MODEL_NAME=Qwen/Qwen3-4B-Instruct-2507
QWEN_MAX_TOKENS=512
QWEN_TEMPERATURE=0.7
QWEN_DEVICE=auto

# --- Embeddings -------------------------------------------------------------
# EMBEDDING_PROVIDER: "openai" or "local"; unset follows LLM_PROVIDER
EMBEDDING_PROVIDER=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Only for embedding models supporting the dimensions option
OPENAI_EMBEDDING_DIMENSIONS=
EMBEDDING_BATCH_SIZE=128
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Reranker ---------------------------------------------------------------
USE_RERANKING=true
RERANK_MODEL=mixedbread-ai/mxbai-rerank-xsmall-v1
RERANK_TOP_K=5

# --- Qdrant -----------------------------------------------------------------
QDRANT_URL=http://localhost:6333
# Empty for the bundled unsecured local server
QDRANT_API_KEY=
QDRANT_TIMEOUT=30
QDRANT_MESSAGES_COLLECTION=chat_messages
QDRANT_DOCUMENTS_COLLECTION=chat_documents
QDRANT_BATCH_SIZE=128

# --- Search -----------------------------------------------------------------
# Minimum cosine similarity for vector results; 0 disables pre-filtering.
# text-embedding-3-* models rarely exceed ~0.5 even for relevant text.
SEARCH_SCORE_THRESHOLD=0
HYBRID_SEARCH_ENABLED=true
HYBRID_PREFETCH_LIMIT=50
BM25_K1=1.2
BM25_B=0.75
BM25_AVERAGE_LENGTH=256

# --- Documents --------------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_FILE_SIZE=52428800
ALLOWED_EXTENSIONS=[".pdf", ".docx", ".xlsx"]
MAX_CONTEXT_CHARS=24000
MAX_QUESTION_LENGTH=8000
